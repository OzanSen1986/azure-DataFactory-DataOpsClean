{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-azure-training"
		},
		"az_ADLS_strialstorage001_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'az_ADLS_strialstorage001'"
		},
		"az_SQLDB_ADF_sql_server_training_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'az_SQLDB_ADF_sql_server_training'"
		},
		"az_ADLS_strialstorage001_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://strialstorage001.dfs.core.windows.net/"
		},
		"az_SQLDB_ADF_sql_server_training_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "az-sql-server-trial-ozan-sen.database.windows.net"
		},
		"az_SQLDB_ADF_sql_server_training_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "az-sqldb-trial-learning"
		},
		"az_SQLDB_ADF_sql_server_training_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "ozan_db_admin"
		},
		"DF_Clean_Trigger_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/7df9a099-df01-425f-8a98-42f1cab67d33/resourceGroups/rg-azure-learning/providers/Microsoft.Storage/storageAccounts/strialstorage001"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-azure-training_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"az_ADLS_strialstorage001_accountKey": {
						"value": "[parameters('az_ADLS_strialstorage001_accountKey')]"
					},
					"az_SQLDB_ADF_sql_server_training_password": {
						"value": "[parameters('az_SQLDB_ADF_sql_server_training_password')]"
					},
					"az_ADLS_strialstorage001_properties_typeProperties_url": {
						"value": "[parameters('az_ADLS_strialstorage001_properties_typeProperties_url')]"
					},
					"az_SQLDB_ADF_sql_server_training_properties_typeProperties_server": {
						"value": "[parameters('az_SQLDB_ADF_sql_server_training_properties_typeProperties_server')]"
					},
					"az_SQLDB_ADF_sql_server_training_properties_typeProperties_database": {
						"value": "[parameters('az_SQLDB_ADF_sql_server_training_properties_typeProperties_database')]"
					},
					"az_SQLDB_ADF_sql_server_training_properties_typeProperties_userName": {
						"value": "[parameters('az_SQLDB_ADF_sql_server_training_properties_typeProperties_userName')]"
					},
					"DF_Clean_Trigger_properties_typeProperties_scope": {
						"value": "[parameters('DF_Clean_Trigger_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-azure-training_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-azure-training_ArmTemplate_0')]"
			]
		}
	]
}