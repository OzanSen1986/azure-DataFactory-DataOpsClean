		{
			"name": "[concat(parameters('factoryName'), '/GetDataFromWeb')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "GetExchangeRateFromRestAPI",
						"description": "Gets ExchangeRates data from RestAPI.",
						"type": "WebActivity",
						"dependsOn": [],
						"policy": {
							"timeout": "0.00:10:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "GET",
							"headers": {},
							"url": "https://api.frankfurter.dev/v1/latest"
						}
					},
					{
						"name": "ForEach_BaseCurrency",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "GetExchangeRateFromRestAPI",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@variables('BaseCurrencies')",
								"type": "Expression"
							},
							"isSequential": false,
							"batchCount": 4,
							"activities": [
								{
									"name": "Copy_FxRates_To_Bronze",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.00:10:00",
										"retry": 2,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "RestSource",
											"httpRequestTimeout": "00:01:40",
											"requestInterval": "00.00:00:00.010",
											"requestMethod": "GET",
											"paginationRules": {
												"supportRFC5988": "true"
											}
										},
										"sink": {
											"type": "JsonSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "JsonWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "az_RestSource_ExchangeRates",
											"type": "DatasetReference",
											"parameters": {
												"RunDate": "2026-07-15",
												"BaseCurrency": {
													"value": "@item()",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_Bronze_FxRates_Json",
											"type": "DatasetReference",
											"parameters": {
												"date": "2026-07-15",
												"currency": {
													"value": "@item()",
													"type": "Expression"
												}
											}
										}
									]
								}
