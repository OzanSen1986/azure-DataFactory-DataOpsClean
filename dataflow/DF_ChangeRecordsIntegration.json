{
	"name": "DF_ChangeRecordsIntegration",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "az_ADLS_ProductSource",
						"type": "DatasetReference"
					},
					"name": "ProductsSourceFile"
				},
				{
					"dataset": {
						"referenceName": "az_SQLDB_dbo_Products",
						"type": "DatasetReference"
					},
					"name": "DimProductSourceTable"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "az_SQLDB_dbo_Products",
						"type": "DatasetReference"
					},
					"name": "SentToAzureDB"
				}
			],
			"transformations": [
				{
					"name": "CheckProductIDExistence"
				},
				{
					"name": "ChangeTypeAction"
				},
				{
					"name": "StampRowsWithAction"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ProductID as integer,",
				"          ProductName as string,",
				"          Price as float,",
				"          Stock as integer,",
				"          IsActive as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ProductsSourceFile",
				"source(output(",
				"          ProductID as integer,",
				"          ProductName as string,",
				"          Price as double,",
				"          Stock as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimProductSourceTable",
				"ProductsSourceFile, DimProductSourceTable lookup(ProductsSourceFile@ProductID == DimProductSourceTable@ProductID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> CheckProductIDExistence",
				"CheckProductIDExistence derive(ChangeType = iif(!IsActive,'DELETE',",
				"iif(isNull(DimProductSourceTable@ProductID), 'INSERT', 'UPDATE')",
				")) ~> ChangeTypeAction",
				"ChangeTypeAction alterRow(insertIf(ChangeType == 'INSERT'),",
				"     updateIf(ChangeType == 'UPDATE'),",
				"     deleteIf(ChangeType == 'DELETE')) ~> StampRowsWithAction",
				"StampRowsWithAction sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ProductID as integer,",
				"          ProductName as string,",
				"          Price as double,",
				"          Stock as integer",
				"     ),",
				"     deletable:true,",
				"     insertable:true,",
				"     updateable:true,",
				"     upsertable:false,",
				"     keys:['ProductID'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> SentToAzureDB"
			]
		}
	}
}